# ── vJetstar Pilot Hub — Environment ────────────────────────────────────
# Copy to repo ROOT as .env  →  cp deploy/.env.example .env

# REQUIRED: generate with:  openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING

# REQUIRED: from setup script output
DATABASE_URL=postgresql://vjetstar:YOUR_DB_PASSWORD@localhost:5432/vjetstar_hub

# Port Express listens on (nginx proxies to this — don't open this port publicly)
PORT=3000

NODE_ENV=production

# Your domain or server IP — used for CORS
# Leave blank to allow all origins (fine behind nginx on same server)
# ALLOWED_ORIGIN=https://pilots.yourdomain.com
